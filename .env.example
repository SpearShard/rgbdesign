# RGB CMS — copy into .env.local for local development.
# Supabase project: rgb-design (Mumbai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ImageKit — public key is safe to expose; private key must remain server-only.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Used only by scripts/import-projects-to-supabase.mjs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
